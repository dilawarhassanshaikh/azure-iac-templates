{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "redis",
      "metadata": {
        "description": "Prefix used to build resource names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Basic",
      "metadata": {
        "description": "Redis SKU name."
      }
    },
    "skuCapacity": {
      "type": "int",
      "defaultValue": 0,
      "metadata": {
        "description": "Redis SKU capacity/size."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "environment": "dev",
        "project": "azure-iac-templates"
      },
      "metadata": {
        "description": "Tags applied to all resources."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "cacheName": "[toLower(format('{0}-{1}', parameters('namePrefix'), variables('uniqueSuffix')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Cache/redis",
      "apiVersion": "2023-08-01",
      "name": "[variables('cacheName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "name": "[parameters('skuName')]",
          "family": "C",
          "capacity": "[parameters('skuCapacity')]"
        },
        "minimumTlsVersion": "1.2",
        "enableNonSslPort": false
      }
    }
  ],
  "outputs": {
    "hostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cache/redis', variables('cacheName')), '2023-08-01').hostName]"
    },
    "sslPort": {
      "type": "int",
      "value": "[reference(resourceId('Microsoft.Cache/redis', variables('cacheName')), '2023-08-01').sslPort]"
    }
  }
}
