{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "afd",
      "metadata": {
        "description": "Prefix used to build resource names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Front Door is a global service; this affects only the deployment's metadata location."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard_AzureFrontDoor",
      "metadata": {
        "description": "Front Door profile SKU."
      }
    },
    "originHostName": {
      "type": "string",
      "metadata": {
        "description": "Hostname of the origin backend (e.g. an App Service default hostname or storage static website endpoint)."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "environment": "dev",
        "project": "azure-iac-templates"
      },
      "metadata": {
        "description": "Tags applied to all resources."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "profileName": "[format('{0}-profile', parameters('namePrefix'))]",
    "endpointName": "[toLower(format('{0}-ep-{1}', parameters('namePrefix'), variables('uniqueSuffix')))]",
    "originGroupName": "[format('{0}-origin-group', parameters('namePrefix'))]",
    "originName": "[format('{0}-origin', parameters('namePrefix'))]",
    "routeName": "[format('{0}-route', parameters('namePrefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Cdn/profiles",
      "apiVersion": "2024-02-01",
      "name": "[variables('profileName')]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}', variables('profileName'), variables('endpointName'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', variables('profileName'))]"
      ],
      "properties": {
        "enabledState": "Enabled"
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}', variables('profileName'), variables('originGroupName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', variables('profileName'))]"
      ],
      "properties": {
        "loadBalancingSettings": {
          "sampleSize": 4,
          "successfulSamplesRequired": 3
        },
        "healthProbeSettings": {
          "probePath": "/",
          "probeRequestType": "HEAD",
          "probeProtocol": "Https",
          "probeIntervalInSeconds": 100
        }
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups/origins",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}/{2}', variables('profileName'), variables('originGroupName'), variables('originName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('profileName'), variables('originGroupName'))]"
      ],
      "properties": {
        "hostName": "[parameters('originHostName')]",
        "httpPort": 80,
        "httpsPort": 443,
        "originHostHeader": "[parameters('originHostName')]",
        "priority": 1,
        "weight": 1000,
        "enabledState": "Enabled"
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints/routes",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}/{2}', variables('profileName'), variables('endpointName'), variables('routeName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', variables('profileName'), variables('endpointName'))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('profileName'), variables('originGroupName'))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups/origins', variables('profileName'), variables('originGroupName'), variables('originName'))]"
      ],
      "properties": {
        "originGroup": {
          "id": "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('profileName'), variables('originGroupName'))]"
        },
        "supportedProtocols": [
          "Http",
          "Https"
        ],
        "patternsToMatch": [
          "/*"
        ],
        "forwardingProtocol": "HttpsOnly",
        "linkToDefaultDomain": "Enabled",
        "httpsRedirect": "Enabled"
      }
    }
  ],
  "outputs": {
    "frontDoorEndpointHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints', variables('profileName'), variables('endpointName')), '2024-02-01').hostName]"
    }
  }
}
