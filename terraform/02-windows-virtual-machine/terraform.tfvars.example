# Prefix used to build resource names
name_prefix = "winvm"

location = "eastus"

admin_username = "azureadmin"

# Must be 12-123 characters and satisfy Azure's complexity rules
# (3 of: lowercase, uppercase, digit, symbol). Do not commit real
# passwords - use a secrets manager or CI/CD secret variable in practice.
admin_password = "ReplaceMe!2026Secure"

vm_size = "Standard_B2s"

# Restrict this to your own IP (e.g. "203.0.113.4/32") in production.
source_address_prefix = "*"

tags = {
  environment = "dev"
  project     = "azure-iac-templates"
}
